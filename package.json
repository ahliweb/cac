{
  "name": "curriculum-as-code",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "description": "Curriculum-as-code for Indonesian informatics programmes (OSN Informatika 2026 first): schema, domain model, and rendering pipeline.",
  "bin": {
    "cac": "src/cli/cac.ts",
    "osn": "src/cli/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "assist:check": "biome check --formatter-enabled=false --linter-enabled=false .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "build": "bun build ./src/index.ts --outdir dist --target bun",
    "validate": "bun run src/cli/index.ts validate",
    "privacy-check": "bun run src/cli/index.ts privacy-check",
    "check:requirements": "bun run scripts/check-requirements.ts",
    "check:checklist-fidelity": "bun run scripts/check-checklist-fidelity.ts",
    "check:module-code": "bun run scripts/check-module-code.ts",
    "check:learner-assets": "bun run scripts/check-learner-assets.ts",
    "check:fidelity": "bun run scripts/check-fidelity.ts",
    "check:sma-fidelity": "bun run scripts/check-sma-coding-fidelity.ts",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.6.9",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
